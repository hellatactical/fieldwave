# REQUIRED -------------------------------------------------------------
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
DISCORD_CLIENT_ID=PASTE_YOUR_APPLICATION_ID_HERE
PANEL_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD

# Panel HTTP port inside the container, and published port on Unraid.
# Use a unique random password of 16+ characters. Do not quote env-file values.
PANEL_PORT=3000
PANEL_HOST_PORT=3000
# Prefer your Unraid LAN IP here to restrict the listening interface.
PANEL_BIND_IP=0.0.0.0
# Set true ONLY when accessing the panel through HTTPS.
PANEL_SECURE_COOKIE=false

# Strongly recommended for a private bot. Commands appear almost instantly.
DISCORD_GUILD_ID=PASTE_YOUR_DISCORD_SERVER_ID_HERE

# OPTIONAL -------------------------------------------------------------
REGISTER_COMMANDS=true
DEFAULT_VOLUME=75
PANEL_UPDATE_SECONDS=15
BOT_STATUS=/play
TZ=America/Los_Angeles

# Paths inside the provided Docker image.
FFMPEG_PATH=/usr/bin/ffmpeg
YTDLP_PATH=/usr/local/bin/yt-dlp
DATA_DIR=/app/data

# Only used by compose.registry.yml after publishing the GitHub image.
FIELDWAVE_IMAGE=ghcr.io/hellatactical/fieldwave:latest
FIELDWAVE_DATA_DIR=/mnt/user/appdata/fieldwave
